# Vertex AI (recommended on Google Cloud)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# ...or the Gemini API instead: comment the three lines above and set
# GEMINI_API_KEY=...

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDER=gemini        # use "fake" to run fully offline
MIN_SIMILARITY=0.55    # tune with eval/run_eval.py on your own data
ALLOYDB=false          # true on AlloyDB to use the ScaNN index
